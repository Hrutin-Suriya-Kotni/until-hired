{
  "description": "until-hired guard: keeps untrusted text out of shell commands and asks the candidate before consent files change.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/hooks/guard.py\" || python \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
